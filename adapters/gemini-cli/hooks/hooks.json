{
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "write_file|replace|run_shell_command",
        "hooks": [
          {
            "type": "command",
            "name": "integration-verifier-protect-policy",
            "description": "Keeps .iv/ (the gate policy and state) under the user's control",
            "command": "node \"${extensionPath}${/}scripts${/}iv-launch.mjs\" hook gemini-cli pre-write",
            "timeout": 15000
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "write_file|replace",
        "hooks": [
          {
            "type": "command",
            "name": "integration-verifier-fast-check",
            "description": "Fast Integration Verifier check of the file just written",
            "command": "node \"${extensionPath}${/}scripts${/}iv-launch.mjs\" hook gemini-cli post-write",
            "timeout": 60000
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "integration-verifier-gate",
            "description": "Integration Verifier gate: asks for another pass while blocking findings are open",
            "command": "node \"${extensionPath}${/}scripts${/}iv-launch.mjs\" hook gemini-cli stop",
            "timeout": 300000
          }
        ]
      }
    ]
  }
}

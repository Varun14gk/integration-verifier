{
  "description": "Integration Verifier: fast check after each file write, full gate before Claude finishes",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/iv-launch.mjs", "hook", "claude-code", "post-write"],
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/iv-launch.mjs", "hook", "claude-code", "stop"],
            "timeout": 300
          }
        ]
      }
    ]
  }
}

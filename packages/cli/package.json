{
  "name": "integration-verifier",
  "version": "0.1.0",
  "description": "Checks that a frontend, backend and APIs are connected correctly and that no data leaks across them",
  "license": "Apache-2.0",
  "author": "The Integration Verifier Authors",
  "homepage": "https://github.com/Varun14gk/integration-verifier#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Varun14gk/integration-verifier.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Varun14gk/integration-verifier/issues"
  },
  "keywords": [
    "api",
    "integration",
    "frontend",
    "backend",
    "openapi",
    "graphql",
    "data-leak",
    "claude-code",
    "codex",
    "gemini-cli",
    "mcp",
    "cli"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "bin": {
    "iv": "dist/index.js"
  },
  "main": "dist/program.js",
  "types": "dist/program.d.ts",
  "files": [
    "dist",
    "adapters",
    ".claude-plugin",
    "!dist/**/*.map"
  ],
  "dependencies": {
    "@integration-verifier/core": "0.1.0",
    "commander": "15.0.0",
    "@integration-verifier/runtime": "0.1.0",
    "@integration-verifier/mcp": "0.1.0",
    "playwright": "1.64.1"
  },
  "scripts": {
    "prepack": "node ../../scripts/prepack.mjs",
    "postpack": "node ../../scripts/prepack.mjs --clean"
  }
}
